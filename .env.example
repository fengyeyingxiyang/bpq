# 复制为 .env 后修改：  cp .env.example .env
# 不要把 .env 提交到 GitHub（已在 .gitignore 中忽略）

# ---- 选择大模型：anthropic | openai | ollama | none ----
# none：不用大模型，只显示手册条目（英文原文），也无法识别照片
LLM_PROVIDER=none

# 模型名，留空则用默认值（anthropic: claude-sonnet-5-5，openai: gpt-4o，ollama: qwen2.5vl:7b）
LLM_MODEL=

# 模型是否能看图。纯文字模型请改为 false，此时照片功能会提示手动输入代码
LLM_VISION=true

# ---- 方案 1：Claude ----
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- 方案 2：OpenAI 兼容接口（OpenAI、通义千问、DeepSeek 等）----
# LLM_PROVIDER=openai
OPENAI_API_KEY=
# OpenAI 默认： https://api.openai.com/v1
# 通义千问：    https://dashscope.aliyuncs.com/compatible-mode/v1   （LLM_MODEL=qwen-vl-max）
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- 方案 3：本地 Ollama ----
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5vl:7b
# Ollama 装在运行 Docker 的这台机器上时用 host.docker.internal；装在别的机器上就写它的 IP
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- 其他 ----
LLM_TIMEOUT=120
LLM_MAX_TOKENS=1200
MAX_IMAGE_MB=10
# 每个 IP 每分钟最多查询次数，0 表示不限制（无密码访问时建议保留限制，防止被人刷 API 额度）
RATE_LIMIT_PER_MIN=20
# 前面有 Nginx/内网穿透等反向代理时改为 true，才能按真实 IP 限速
TRUST_PROXY=false
